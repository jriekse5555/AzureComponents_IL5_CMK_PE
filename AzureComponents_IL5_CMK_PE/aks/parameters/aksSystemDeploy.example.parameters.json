{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "dnsZoneRgpName": {
            "value": "<rg name>"
        },
        "dnsZoneRgpSubId": {
            "value": "<subid>"
        },
        "cmkDESRoles": {
            "value": [
                "aks"
            ]
        },
        "storageAccountSku": {
            "value": "Standard_LRS"
        },
        "fileShares": {
            "value": []
        },
        "aksClusterNetworkPlugin": {
            "value": "azure"
        },
        "aksClusterNetworkPolicy": {
            "value": "azure"
        },
        "aksClusterServiceCidr": {
            "value": "10.100.0.0/16"
        },
        "aksClusterDnsServiceIP": {
            "value": "10.100.0.10"
        },
        "aksClusterSkuTier": {
            "value": "Free"
        },
        "aksClusterKubernetesVersion": {
            "value": "1.35.5"
        },
        "aadProfileAdminGroupObjectIDs": {
            "value": [
                "<objectid>"
            ]
        },
        "aksPrivateDNSZoneId": {
            "value": "<aksprivatednszoneresourceid>"
        },
        "aadProfileManaged": {
            "value": true
        },
        "aadProfileEnableAzureRBAC": {
            "value": true
        },
        "disableLocalAccounts": {
            "value": true
        },
        "enablePrivateCluster": {
            "value": true
        },
        "primaryAgentPoolProfile": {
            "value": [
                {
                    "name": "sysnodepool",
                    "osDiskSizeGB": 0,
                    "count": 1,
                    "enableAutoScaling": true,
                    "minCount": 1,
                    "maxCount": 3,
                    "vmSize": "standard_b4ms",
                    "osType": "Linux",
                    "type": "VirtualMachineScaleSets",
                    "mode": "System",
                    "vnetSubnetID": "<subnetresourceid>",
                    "maxPods": 30,
                    "availabilityZones": [
                    ],
                    "nodeTaints": [
                        "CriticalAddonsOnly=true:NoSchedule"
                    ],
                    "enableEncryptionAtHost": true
                }
            ]
        },
        "enableKeyvaultSecretsProvider": {
            "value": true
        },
        "enableSecretRotation": {
            "value": "true"
        },
        "enableAzureDefender": {
            "value": false
        },
        "managedOutboundIPCount": {
            "value": 1
        }
    }
}
